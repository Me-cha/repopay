# Runtime configuration validated by packages/server/src/env.ts.
# Blank secrets/model require local values. No provider credentials are included.
# Development examples are explicit configuration, not production defaults.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://gitpay:gitpay@127.0.0.1:5433/gitpay
TEST_DATABASE_URL=postgresql://gitpay:gitpay@127.0.0.1:5433/gitpay_test
WORKER_MODE=inline
SESSION_SECRET=
TOKEN_ENC_KEY=
PAYMENT_DATA_ENC_KEY=
ACTION_TOKEN_TTL_SEC=900

# GitHub App: populate locally; never commit the real private key.
GH_APP_ID=
GH_APP_SLUG=
GH_PRIVATE_KEY=
GH_WEBHOOK_SECRET=
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# Sandbox only; boot validation must refuse another PayPal base URL.
PP_BASE=https://api-m.sandbox.paypal.com
PP_CLIENT_ID=
PP_SECRET=
PP_WEBHOOK_ID=

# Runtime verifier; independent from the Codex development assistant.
NVIDIA_API_KEY=
NVIDIA_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MAX_TOKENS=2048
NVIDIA_TIMEOUT_MS=120000
POLICY_MIN_CONFIDENCE=0.75
POLICY_CI_REQUIRED=true
POLICY_MIN_SHARE=0.05
MAX_BOUNTY_CENTS=100000
MAX_DIFF_CHARS=160000
POLL_INTERVAL_MS=5000
JOB_LEASE_SEC=120
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RESPONSE_MAX_BYTES=1048576
WEBHOOK_BODY_MAX_BYTES=1048576
RECONCILIATION_INTERVAL_SEC=60
RECONCILIATION_PAGE_LIMIT=100
RECONCILIATION_RATE_PER_MIN=30
RECONCILIATION_MAX_ATTEMPTS=10
SSE_HEARTBEAT_SEC=30

# Enable only after Phase 08 and independent reviewer setup are verified.
FUNDED_CANCELLATION_ENABLED=false
CANCELLATION_OPERATOR_GH_IDS=
CANCELLATION_NOTICE_HOURS=72

# Used only by explicit pnpm preflight --sandbox-payment; never logged.
PREFLIGHT_SANDBOX_RECIPIENT=
