# Planned runtime configuration; no application reads this yet.
# Phase 0 must validate these fields. Blank secrets/model require local values.
# Development examples are explicit configuration, not production defaults.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=
WORKER_MODE=inline
SESSION_SECRET=
TOKEN_ENC_KEY=
ACTION_TOKEN_TTL_SEC=900

# GitHub App: populate locally; never commit the real private key.
GH_APP_ID=
GH_APP_SLUG=
GH_PRIVATE_KEY=
GH_WEBHOOK_SECRET=
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# Sandbox only; boot validation must refuse another PayPal base URL.
PP_BASE=https://api-m.sandbox.paypal.com
PP_CLIENT_ID=
PP_SECRET=
PP_WEBHOOK_ID=

# Runtime verifier; independent from the Codex development assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
POLICY_MIN_CONFIDENCE=0.75
POLICY_CI_REQUIRED=true
POLICY_MIN_SHARE=0.05
MAX_BOUNTY_CENTS=100000
MAX_DIFF_CHARS=160000
POLL_INTERVAL_MS=5000
JOB_LEASE_SEC=120

# Enable only after Phase 7 and independent reviewer setup are verified.
FUNDED_CANCELLATION_ENABLED=false
CANCELLATION_OPERATOR_GH_IDS=
CANCELLATION_NOTICE_HOURS=72

# Optional dashboard license; do not invent or commit an actual license key.
VITE_AG_GRID_LICENSE=
