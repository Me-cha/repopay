# HTTP/worker startup validates GitHub/database/session and sandbox funding settings.
# Standalone workers and provider probes validate only the settings they consume.
# Runtime configuration validated by packages/server/src/env.ts.
# Blank secrets/model require local values. No provider credentials are included.
# Development examples are explicit configuration, not production defaults.
NODE_ENV=development
# Default preserves the current shared worker. Isolated execution is opt-in.
REVIEW_BACKEND=shared
REVIEW_GENERATION=1
# REVIEW_EXECUTOR_KEY=<independent 32-byte base64 key>
# RENDER_API_KEY=<dispatcher-only Render API key>
# RENDER_REVIEW_TASK=repopay-reviews/verifySubmission:<deployed-task-version>
PORT=3000
PUBLIC_URL=http://localhost:3000
# Stable account-assigned ngrok dev hostname for local callback testing only.
# Use hostname only (e.g. account-name.ngrok-free.dev); keep the token in ngrok config.
NGROK_DOMAIN=
DATABASE_URL=postgresql://repopay:repopay@127.0.0.1:5433/repopay
TEST_DATABASE_URL=postgresql://repopay:repopay@127.0.0.1:5433/repopay_test
WORKER_MODE=inline
# Set hold on every restored service before it connects to the database.
RECOVERY_MODE=normal
SESSION_SECRET=
TOKEN_ENC_KEY=
PAYMENT_DATA_ENC_KEY=
ACTION_TOKEN_TTL_SEC=900
SESSION_TTL_SEC=604800
OAUTH_STATE_TTL_SEC=600

# GitHub App: populate locally; never commit the real private key.
GH_APP_ID=
GH_APP_SLUG=
GH_PRIVATE_KEY=
GH_WEBHOOK_SECRET=
GH_CLIENT_ID=
# OAuth client secret from the same App as GH_CLIENT_ID; not its private key.
GH_CLIENT_SECRET=

# Sandbox only; boot validation must refuse another PayPal base URL.
PP_BASE=https://api-m.sandbox.paypal.com
PP_CLIENT_ID=
PP_SECRET=
# Required for application webhook handling, not Phase 0 provider preflight.
PP_WEBHOOK_ID=

# Local Copilot probes only. Production funding uses the repository owner's
# separately consented sponsor connection stored encrypted in Postgres.
# Never use the operator's probe token as a fallback for customer repositories.
COPILOT_GITHUB_TOKEN=
COPILOT_AUTH_KIND=user
COPILOT_BILLING_OWNER_ID=
# Fixed model bound into new bounty terms; Auto is forbidden.
COPILOT_MODEL=auto
COPILOT_TIMEOUT_MS=120000
COPILOT_SHUTDOWN_TIMEOUT_MS=5000
COPILOT_MAX_INPUT_BYTES=200000
POLICY_MIN_CONFIDENCE=0.75
POLICY_CI_REQUIRED=true
POLICY_MIN_SHARE=0.05
MAX_BOUNTY_CENTS=100000
MAX_DIFF_CHARS=160000
POLL_INTERVAL_MS=5000
JOB_LEASE_SEC=120
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RESPONSE_MAX_BYTES=1048576
WEBHOOK_BODY_MAX_BYTES=1048576
# New GitHub discovery can enqueue sponsored reviews; enable only for approved live work.
RECONCILIATION_DISCOVERY_ENABLED=false
RECONCILIATION_INTERVAL_SEC=60
RECONCILIATION_PAGE_LIMIT=100
RECONCILIATION_RATE_PER_MIN=30
RECONCILIATION_MAX_ATTEMPTS=10
# Scoped stream authorization and browser full-refetch cadence (1–300 seconds).
SSE_HEARTBEAT_SEC=30

# Default off. Phase 08 permits explicitly authorized isolated sandbox validation
# after local safety tests; broader enablement requires its real refund gate.
FUNDED_CANCELLATION_ENABLED=false
CANCELLATION_SANDBOX_REPO_ID=
# Stable numeric GitHub IDs; reviewer must not be requester/funder/creator/claimant.
CANCELLATION_OPERATOR_GH_IDS=
CANCELLATION_NOTICE_HOURS=72

# Used only by explicit pnpm preflight --sandbox-payment; never logged.
PREFLIGHT_SANDBOX_RECIPIENT=

# Phase 3 sandbox funding: blank merchant/CI config blocks checkout.
# Business sandbox account merchant ID (not an email, app ID or client ID).
PP_MERCHANT_ID=
# Set PP_WEBHOOK_ID above after registering ${PUBLIC_URL}/webhooks/paypal.
# Conservative retry window for both capture and immutable payout submission.
PP_SAFE_RETRY_SEC=18000
PP_VERIFY_CONCURRENCY=2
POLICY_VERSION=repopay-v2-copilot
# JSON keyed by stable repository ID; real required check names and producing App IDs.
# Correct shape: {"123456":[{"name":"test","appId":"15368"}]}
POLICY_CI_CONTEXTS={}
# Conservative request-count limits per repository. These do not replace the
# sponsor's GitHub Copilot billing controls or guarantee a currency spend cap.
VERIFIER_DAILY_ATTEMPT_LIMIT=25
VERIFIER_MAX_ATTEMPTS_PER_SHA=3

# Foundation sandbox (ADR 0021): blank keeps automatic awards disabled.
# Configure only the explicitly approved bounty; JSON binds bountyId, repoId, amountCents and the stored termsHash.
# This does not enable general/production settlement or change funded terms.
SETTLEMENT_DEMO_SCOPE=
