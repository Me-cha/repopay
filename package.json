{
  "name": "gitpay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env packages/server/src/main.ts",
    "build": "pnpm --filter @gitpay/server build",
    "start": "node --env-file=.env packages/server/dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env packages/server/scripts/migrate.ts",
    "preflight": "tsx --env-file-if-exists=.env packages/server/scripts/preflight.ts",
    "eval:verifier": "tsx --env-file-if-exists=.env packages/server/scripts/eval-verifier.ts",
    "dev:worker": "tsx watch --env-file=.env packages/server/src/worker.ts",
    "start:worker": "node --env-file=.env packages/server/dist/worker.js",
    "tunnel": "bash ./ngrok.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "nock": "15.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "drizzle-kit": "0.31.11"
  }
}
